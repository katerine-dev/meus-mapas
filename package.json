{
  "name": "meus-mapas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:clean": "docker compose down -v",
    "db:logs": "docker compose logs -f meus-mapas-db",
    "migrations:create": "node-pg-migrate create -j sql",
    "migrations:migrate": "node-pg-migrate up --envPath .env.local",
    "test": "vitest",
    "test:unit": "vitest --config vitest.component.config.ts",
    "test:all": "npm run test:unit -- --run && npm run test -- --run"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "leaflet": "^1.9.4",
    "next": "16.0.10",
    "pg": "^8.16.3",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-leaflet": "^5.0.0",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "happy-dom": "^18.0.1",
    "jsdom": "^27.4.0",
    "node-pg-migrate": "^7.9.1",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "uuid": "^13.0.0",
    "vitest": "^4.0.16"
  }
}
